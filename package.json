{
  "name": "fcr-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "fastconfirm.it — the Fast Confirmation Rule website",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-data.mjs",
    "build": "node scripts/validate-data.mjs && node scripts/game/check-courses.mjs 500 && vite build && vitepress build docs && node scripts/perf/postbuild.mjs",
    "preview": "vite preview",
    "build:drafts": "SHOW_DRAFTS=1 npm run build",
    "docs:dev": "vitepress dev docs",
    "time-saved": "node scripts/time-saved/run.mjs",
    "test:speed": "node scripts/perf/docs-speed.mjs",
    "serve": "node scripts/perf/serve.mjs"
  },
  "dependencies": {
    "@fontsource/overpass": "5.3.0",
    "@fontsource/overpass-mono": "5.2.5",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@noble/hashes": "1.8.0",
    "beasties": "^0.5.5",
    "playwright": "^1.63.0",
    "vite": "7.3.1",
    "vitepress": "1.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
