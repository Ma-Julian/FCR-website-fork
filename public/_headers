# Response headers, read by Netlify and Cloudflare Pages from dist/ (the build copies this file there).
# HSTS and X-Frame-Options match what the first fastconfirm.it sent, so the domain keeps its HSTS preload.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'inline-speculation-rules'; connect-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Hashed files never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/docs/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The docs offline cache's worker must always be checked for a new version.
/sw.js
  Cache-Control: no-cache
